#!/usr/bin/env bash
# Stub `tmux` for unit tests. Reads MOCK_OPT_<sanitized> env vars to mimic
# `tmux show-option -gqv @useful-foo-bar` lookups.
#
# Mapping: option name -> env var name
#   strip leading '@', replace '-' with '_'
#   e.g. @useful-mem-warn -> MOCK_OPT_useful_mem_warn

# Resolve a single #{...} format token into $_LOOKUP. Setting a global rather
# than echoing keeps the batch expansion below fork-free.
lookup() {
    local tok="$1" var
    case "$tok" in
        @*)
            # Simulate a tmux too old to expand #{@user-option}. Two shapes:
            # echo the token back verbatim, or expand it to nothing.
            if [ -n "${MOCK_TMUX_LITERAL_USER_FORMATS:-}" ]; then
                _LOOKUP="#{$tok}"; return
            fi
            if [ -n "${MOCK_TMUX_EMPTY_USER_FORMATS:-}" ]; then
                _LOOKUP=""; return
            fi
            var="MOCK_OPT_$(printf "%s" "$tok" | tr -d '@' | tr '-' '_')"
            eval "_LOOKUP=\"\${$var:-}\""
            ;;
        pane_current_command) _LOOKUP="${MOCK_PANE_COMMAND:-zsh}" ;;
        pane_current_path)    _LOOKUP="${MOCK_PANE_PATH:-$HOME}" ;;
        *)                    _LOOKUP="" ;;
    esac
}

# Expand a format string, substituting #{...} tokens and passing literals
# (including the \037 separators and the trailing END sentinel) through.
expand_format() {
    local fmt="$1" out="" pre rest tok
    while [ -n "$fmt" ]; do
        case "$fmt" in
            *'#{'*)
                pre="${fmt%%#\{*}"
                rest="${fmt#*#\{}"
                tok="${rest%%\}*}"
                fmt="${rest#*\}}"
                lookup "$tok"
                out="$out$pre$_LOOKUP"
                ;;
            *)
                out="$out$fmt"
                fmt=""
                ;;
        esac
    done
    printf "%s" "$out"
}

# tmux show-options -g — helpers.sh uses this only to answer "are any
# @useful-* options set at all?", never to parse values.
if [ "$1" = "show-options" ] && [ "$2" = "-g" ]; then
    while IFS= read -r line; do
        case "$line" in
            MOCK_OPT_*)
                name="${line%%=*}"; value="${line#*=}"
                name="${name#MOCK_OPT_}"
                printf '@%s %s\n' "${name//_/-}" "$value"
                ;;
        esac
    done < <(env)
    exit 0
fi

if [ "$1" = "show-option" ] && [ "$2" = "-gqv" ] && [ -n "$3" ]; then
    opt="$3"
    var="MOCK_OPT_$(printf "%s" "$opt" | tr -d '@' | tr '-' '_')"
    eval "printf '%s' \"\${$var:-}\""
    exit 0
fi

# tmux display[-message] -p '<format>' — used by the batched config load in
# helpers.sh and by the per-call fallbacks in git.sh / pane.sh.
if { [ "$1" = "display" ] || [ "$1" = "display-message" ]; } && [ "$2" = "-p" ] && [ -n "$3" ]; then
    # MOCK_NO_TMUX_SERVER=1 simulates "no server/session answered", which is
    # what drives helpers.sh onto its per-option fallback path.
    [ -n "${MOCK_NO_TMUX_SERVER:-}" ] && exit 1
    expand_format "$3"
    exit 0
fi

# set-option / unset-option / anything else: silent no-op.
exit 0
